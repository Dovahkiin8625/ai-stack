{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "桌面专属权限（window-state 等移动端不可用的插件）。",
  "windows": ["main"],
  "platforms": ["windows", "linux", "macOS"],
  "permissions": [
    "core:default",
    "store:default",
    "window-state:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$RESOURCE/**" }]
    },
    "dialog:default",
    "sql:default"
  ]
}
